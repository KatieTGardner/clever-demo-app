<!DOCTYPE html>
<html>
<head>
  <title>LMS Connect Status</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #1a1a1a; }
    h1 { font-size: 1.5rem; margin-bottom: 4px; }
    .back { color: #555; font-size: 0.875rem; text-decoration: none; }
    .back:hover { color: #000; }
    .card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 20px; margin-top: 24px; }
    .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; margin-bottom: 4px; }
    .value { font-size: 1rem; font-weight: 500; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: 0.8rem; font-weight: 600; }
    .badge.connected { background: #dcfce7; color: #15803d; }
    .badge.disconnected { background: #fee2e2; color: #b91c1c; }
    .badge.pending { background: #fef9c3; color: #854d0e; }
    pre { background: #f4f4f4; padding: 12px; border-radius: 6px; font-size: 0.8rem; overflow-x: auto; }
  </style>
</head>
<body>
  <a class="back" href="/dashboard">← Dashboard</a>
  <h1 style="margin-top: 12px;">LMS Connect Status</h1>
  <p style="color:#555; font-size:0.9rem;">Schoology connection status for your district.</p>

  <div class="card">
    <div class="label">LMS</div>
    <div class="value"><%= status.data?.lms || 'Schoology' %></div>
  </div>

  <div class="card">
    <div class="label">Connection Status</div>
    <div class="value">
      <% const s = (status.data?.lms_status || 'unknown').toLowerCase(); %>
      <span class="badge <%= s === 'connected' ? 'connected' : s === 'pending' ? 'pending' : 'disconnected' %>">
        <%= status.data?.lms_status || 'Unknown' %>
      </span>
    </div>
  </div>

  <div class="card">
    <div class="label">Raw API Response</div>
    <pre><%= JSON.stringify(status, null, 2) %></pre>
  </div>
</body>
</html>
