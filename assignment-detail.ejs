<!DOCTYPE html>
<html>
<head>
  <title>Assignment Detail</title>
  <style>
    body { font-family: sans-serif; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #1a1a1a; }
    h1 { font-size: 1.5rem; margin-bottom: 4px; }
    h2 { font-size: 1.1rem; margin: 32px 0 12px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
    .back { color: #555; font-size: 0.875rem; text-decoration: none; }
    .back:hover { color: #000; }
    .meta { display: flex; gap: 24px; margin-top: 12px; flex-wrap: wrap; }
    .meta-item { font-size: 0.85rem; color: #555; }
    .meta-item strong { color: #1a1a1a; }
    .desc { margin-top: 16px; background: #f9fafb; border-left: 3px solid #e5e7eb; padding: 12px 16px; border-radius: 0 6px 6px 0; font-size: 0.9rem; color: #444; }
    .actions { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 8px 16px; border-radius: 6px; font-size: 0.875rem; font-weight: 500; text-decoration: none; cursor: pointer; border: none; }
    .btn-ghost { background: transparent; color: #2563eb; border: 1px solid #2563eb; }
    .btn-ghost:hover { background: #eff6ff; }
    .btn-danger { background: transparent; color: #dc2626; border: 1px solid #dc2626; }
    .btn-danger:hover { background: #fef2f2; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th { text-align: left; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; border-bottom: 2px solid #e5e7eb; }
    td { padding: 12px; border-bottom: 1px solid #f0f0f0; }
    tr:hover td { background: #f9fafb; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
    .badge.submitted { background: #dbeafe; color: #1d4ed8; }
    .badge.returned { background: #dcfce7; color: #15803d; }
    .badge.draft { background: #f3f4f6; color: #6b7280; }
    .action-link { font-size: 0.8rem; color: #2563eb; text-decoration: none; }
    .action-link:hover { text-decoration: underline; }
    .empty { color: #888; font-size: 0.9rem; margin-top: 16px; }
    .student-notice { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 16px; margin-top: 24px; font-size: 0.9rem; color: #1e40af; }
  </style>
</head>
<body>
  <a class="back" href="/lms/sections/<%= sectionId %>/assignments">← All Assignments</a>
  <h1 style="margin-top: 12px;"><%= assignment.title || 'Untitled Assignment' %></h1>

  <div class="meta">
    <div class="meta-item">Due: <strong><%= assignment.due ? new Date(assignment.due).toLocaleString() : 'No due date' %></strong></div>
    <div class="meta-item">Points: <strong><%= assignment.max_points != null ? assignment.max_points : 'Ungraded' %></strong></div>
  </div>

  <% if (assignment.description) { %>
    <div class="desc"><%= assignment.description %></div>
  <% } %>

  <% if (role !== 'student') { %>
    <div class="actions">
      <a class="btn btn-ghost" href="/lms/sections/<%= sectionId %>/assignments/<%= assignment.id %>/edit">Edit Assignment</a>
      <form method="POST" action="/lms/sections/<%= sectionId %>/assignments/<%= assignment.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this assignment? This cannot be undone.')">
        <button type="submit" class="btn btn-danger">Delete Assignment</button>
      </form>
    </div>

    <h2>Submissions (<%= submissions.length %>)</h2>

    <% if (!submissions.length) { %>
      <p class="empty">No submissions yet. Students need to submit in Schoology first before you can grade them here.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Student ID</th>
            <th>State</th>
            <th>Score</th>
            <th>Submitted</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% submissions.forEach(sub => { %>
            <tr>
              <td><code style="font-size:0.8rem"><%= sub.user_id || sub.userId || '—' %></code></td>
              <td>
                <% const state = (sub.state || 'draft').toLowerCase(); %>
                <span class="badge <%= state %>"><%= state %></span>
              </td>
              <td><%= sub.score != null ? sub.score : '—' %></td>
              <td style="font-size:0.8rem; color:#666;"><%= sub.submitted_at ? new Date(sub.submitted_at).toLocaleDateString() : '—' %></td>
              <td>
                <a class="action-link" href="/lms/sections/<%= sectionId %>/assignments/<%= assignment.id %>/submissions/<%= sub.user_id || sub.userId %>">Grade</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

  <% } else { %>
    <div class="student-notice">
      To submit this assignment, open it in Schoology directly. Once you've submitted, your teacher will be able to grade it here.
    </div>
  <% } %>
</body>
</html>
